# Copiez ce fichier sous le nom .env et collez vos propres clés après le signe =.
# Ne partagez jamais votre fichier .env et ne le publiez pas en ligne : c’est votre clé de la maison.

# Clé gratuite sur https://console.groq.com/keys (nécessaire dès la Planète Chatbot)
GROQ_API_KEY=

# Facultatif : token gratuit sur https://huggingface.co/settings/tokens
# (seulement pour les modèles à accès restreint ; les modèles publics se téléchargent sans)
HF_TOKEN=

# Planète Mémoire : adresse de votre base de données PostgreSQL (voir chapitre 20)
POSTGRES_URL=postgresql://postgres:comet@localhost:5432/postgres
